# Discord Rich Presence (Optional)
# Leave empty to use default, or provide your custom Discord Application ID
# RIZE_DISCORD_CLIENT_ID=your_discord_client_id
# RIZE_DISCORD_LARGE_IMAGE_KEY=rize

# Google OAuth & Firebase Cloud Sync (Optional)
# You can either provide firebase-config.json or define configuration via environment variables
# VOTIFY_GOOGLE_DESKTOP_CLIENT_ID=your_desktop_client_id.apps.googleusercontent.com
# VOTIFY_GOOGLE_DESKTOP_CLIENT_SECRET=your_desktop_client_secret
# RIZE_FIREBASE_CONFIG='{"apiKey":"...","authDomain":"...","projectId":"...","appId":"..."}'

