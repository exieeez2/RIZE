# GitHub Linguist Configuration
# Only count Rust and Kotlin in repository language statistics

* -linguist-detectable
* linguist-vendored

# Rust Tauri Core
*.rs linguist-detectable linguist-language=Rust -linguist-vendored
src-tauri/**/*.rs linguist-detectable linguist-language=Rust -linguist-vendored
src-tauri/** linguist-detectable linguist-language=Rust -linguist-vendored

# Kotlin Jetpack Compose Core
*.kt linguist-detectable linguist-language=Kotlin -linguist-vendored
*.kts linguist-detectable linguist-language=Kotlin -linguist-vendored
android/app/src/main/java/**/*.kt linguist-detectable linguist-language=Kotlin -linguist-vendored

# Vendor everything else
src/** linguist-vendored -linguist-detectable
routes/** linguist-vendored -linguist-detectable
test/** linguist-documentation -linguist-detectable
scripts/** linguist-documentation -linguist-detectable
design/** linguist-documentation -linguist-detectable
android/app/src/main/assets/** linguist-vendored -linguist-detectable
